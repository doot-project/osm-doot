# Auto detect text files and perform LF normalization
* text=auto

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - CRITICAL: Never convert line endings on game assets!
*.dat binary
*.rttex binary
*.mp3 binary
*.wav binary
*.ogg binary
*.png binary
*.jpg binary
*.jpeg binary
*.bin binary
